{
  "consumer": {
    "name": "Reservation App"
  },
  "interactions": [
    {
      "description": "a request to create a valid reservation",
      "providerStates": [
        {
          "name": "a new valid reservation can be created"
        }
      ],
      "request": {
        "body": {
          "date": "2026-09-10",
          "hours": 2,
          "room": "SALA-1",
          "userId": "U100"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/reservations"
      },
      "response": {
        "body": {
          "active": true,
          "date": "2026-09-10",
          "hours": 2,
          "id": "R-1001",
          "room": "SALA-1",
          "userId": "U100"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "R-[0-9]+"
                }
              ]
            }
          }
        },
        "status": 201
      }
    },
    {
      "description": "a request to create an invalid reservation",
      "providerStates": [
        {
          "name": "a new invalid reservation can be rejected"
        }
      ],
      "request": {
        "body": {
          "date": "2026-09-10",
          "hours": 0,
          "room": "SALA-1",
          "userId": "U100"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/reservations"
      },
      "response": {
        "body": {
          "error": "INVALID_HOURS"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 400
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.5.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Reservation Service"
  }
}