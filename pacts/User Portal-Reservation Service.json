{
  "consumer": {
    "name": "User Portal"
  },
  "interactions": [
    {
      "description": "a request for the reservations of U100",
      "providerStates": [
        {
          "name": "user U100 has an active reservation"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/users/U100/reservations"
      },
      "response": {
        "body": [
          {
            "active": true,
            "date": "2026-09-10",
            "hours": 2,
            "id": "R-1001",
            "room": "SALA-1",
            "userId": "U100"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for the reservations of U200",
      "providerStates": [
        {
          "name": "user U200 has no reservations"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/users/U200/reservations"
      },
      "response": {
        "body": [],
        "headers": {
          "Content-Type": "application/json"
        },
        "status": 200
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "Reservation Service"
  }
}